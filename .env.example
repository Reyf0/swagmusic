# Supabase project (Dashboard → Project Settings → API Keys)
NUXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_…) — safe to expose to the browser
NUXT_PUBLIC_SUPABASE_KEY=
# Secret key (sb_secret_…). Server-only: admin API routes (server/api/v1/users/*).
SUPABASE_SECRET_KEY=

# Optional
NUXT_PUBLIC_SENTRY_DSN=
# Public site URL (used by @nuxtjs/seo for canonical URLs / sitemap)
NUXT_SITE_URL=http://localhost:3000

# Local tooling only (schema snapshot / migrations). Not needed by the app.
SUPABASE_DB_PASSWORD=
