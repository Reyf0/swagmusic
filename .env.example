# Supabase project (Dashboard → Project Settings → API)
NUXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NUXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by admin API routes (server/api/v1/users/*). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Optional
NUXT_PUBLIC_SENTRY_DSN=
# Public site URL (used by @nuxtjs/seo for canonical URLs / sitemap)
NUXT_SITE_URL=http://localhost:3000

# Local tooling only (schema snapshot / migrations). Not needed by the app.
SUPABASE_DB_PASSWORD=
